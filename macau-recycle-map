  <script type="module">
    // Firebase 初始化與全局導出
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, collection, addDoc, getDocs, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    const appId = typeof __app_id !== 'undefined' ? __app_id : 'macau-recycle-app';
    const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
    
    let db = null, auth = null, currentUser = null;

    if (firebaseConfig && firebaseConfig.apiKey && firebaseConfig.apiKey !== "demo") {
      try {
        const app = initializeApp(firebaseConfig);
        db = getFirestore(app);
        auth = getAuth(app);
        
        onAuthStateChanged(auth, (user) => {
          if (user) {
            currentUser = user;
            window.firebaseDb = db;
            window.currentUserId = user.uid;
            window.appId = appId;
            loadAuthorRecords();
          }
        });

        signInAnonymously(auth).catch(() => {
          // 靜默捕捉匿名登入失敗，自動降級為本地儲存
        });
      } catch(e) {
        // 模組初始化失敗，降級處理
      }
    }

    window.saveRecordToCloud = async function(record) {
      // 若沒有登入 token 或沒配置資料庫權限，直接安全保存在本地，不觸發錯誤提示
      if (!db || !currentUser) {
        return;
      }
      try {
        const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'recycling_submissions');
        await addDoc(colRef, {
          ...record,
          userId: currentUser.uid,
          createdAt: new Date().toISOString()
        });
        loadAuthorRecords();
      } catch(e) {
        // 捕捉 Missing or insufficient permissions 權限異常，靜默忽略並不中斷 UI
      }
    };

    window.loadAuthorRecords = async function() {
      const authorList = document.getElementById('author-history-list');
      if (!authorList) return;
      
      if (!db || !currentUser) {
        authorList.innerHTML = `<p class="text-slate-400 text-center py-4">本地預覽模式（雲端審核資料庫未連接）</p>`;
        return;
      }

      try {
        const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'recycling_submissions');
        const snapshot = await getDocs(colRef);
        if (snapshot.empty) {
          authorList.innerHTML = `<p class="text-slate-400 text-center py-4">目前尚無任何同學/市民提交照片記錄。</p>`;
          return;
        }
        authorList.innerHTML = '';
        snapshot.forEach(doc => {
          const data = doc.data();
          const item = document.createElement('div');
          item.className = "p-2.5 bg-slate-50 rounded-xl border border-slate-200 flex space-x-3 items-center";
          item.innerHTML = `
            <img src="${data.photoData}" class="w-12 h-12 rounded-lg object-cover border">
            <div class="flex-grow">
              <div class="flex justify-between items-center">
                <span class="font-bold text-slate-700">${data.taskTitle}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded ${data.passed ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">${data.passed ? '✓ AI 驗證真實' : '❌ 懷疑作假'}</span>
              </div>
              <p class="text-[10px] text-slate-500">用戶ID: ${(data.userId || '').substring(0,8)}... | ${new Date(data.createdAt || Date.now()).toLocaleTimeString()}</p>
              <p class="text-[10px] text-slate-600 italic mt-0.5">AI評語: ${data.aiAnalysis}</p>
            </div>
          `;
          authorList.appendChild(item);
        });
      } catch(e) {
        authorList.innerHTML = `<p class="text-slate-400 text-center py-4">本地預覽模式（雲端審核資料庫未開放讀取）</p>`;
      }
    };
  </script>

  <script>
    // ==================== 1. 澳門回收站點真實資料數據庫 ====================
    const recyclingLocations = [
      {
        id: 1,
